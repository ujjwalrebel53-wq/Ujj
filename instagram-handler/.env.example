# Copy to .env and set your own secret key
SECRET_KEY=change-this-to-a-random-32-byte-string
ENCRYPTION_KEY=change-this-to-a-fernet-key
FLASK_PORT=5050
FLASK_DEBUG=false

# Webshare proxy list API (auto-assigns proxies when account has no proxy)
WEBSHARE_PROXY_URL=https://proxy.webshare.io/api/v2/proxy/list/download/YOUR_TOKEN/-/any/username/direct/-/?plan_id=YOUR_PLAN
